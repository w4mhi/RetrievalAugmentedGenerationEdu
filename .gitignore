## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Bb]in/
[Oo]bj/
[Ll]og/

# Python
python_env/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ChromaDB
chroma_db/

# ONNX Models (large files - download separately)
models/
*.onnx

# PDF documents (add your own PDFs)
pdf/*.pdf

# VS Code
.vscode/
*.code-workspace

# .NET
*.swp
*.*~
project.lock.json
.DS_Store
*.pyc
nupkg/

# NuGet
*.nupkg
*.snupkg

# Test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# Visual Studio cache/options
.vs/

# User settings
appsettings.Development.json
